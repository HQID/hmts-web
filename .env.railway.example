# ==============================================================================
# Environment Variables for Railway Deployment (HMTS-UNTAD)
# Salin variabel ini ke tab "Variables" pada Web Service di Railway Dashboard
# ==============================================================================

APP_NAME="HMTS FT-UNTAD"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERATE_KEY_DENGAN_PHP_ARTISAN_KEY_GENERATE_SHOW
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database MySQL Railway (Otomatis mengambil referensi dari service MySQL)
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# Session, Cache, & Queue menggunakan Database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=database

# Auto Migration & Seeder saat Deployment
RUN_MIGRATIONS=true
# Set RUN_SEEDER=true pada deploy pertama untuk membuat akun superadmin & data awal, lalu bisa ubah ke false
RUN_SEEDER=true
